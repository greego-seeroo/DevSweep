      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Editoren & IDEs"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Editores e IDE"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éditeurs et IDE"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エディタ・IDE"
          }
        }
      }
    },
    "Either your caches are already empty, or DevSweep could not read them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entweder sind Ihre Caches bereits leer, oder DevSweep konnte sie nicht lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "O tus cachés ya están vacías, o DevSweep no ha podido leerlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soit vos caches sont déjà vides, soit DevSweep n’a pas pu les lire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュがすでに空か、DevSweepが読み取れなかったかのどちらかです。"
          }
        }
      }
    },
