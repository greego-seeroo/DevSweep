    ".NET build intermediates.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischenergebnisse von .NET-Builds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos intermedios de compilación de .NET."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers intermédiaires de compilation .NET."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".NETのビルド中間ファイルです。"
          }
        }
      }
    },
    ".NET build output. Rebuilt by `dotnet build`.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ".NET-Build-Ausgabe. Wird von `dotnet build` neu erstellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultado de compilación de .NET. Se regenera con `dotnet build`."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortie de compilation .NET. Reconstruite par `dotnet build`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".NETのビルド出力です。`dotnet build` で再生成されます。"
          }
        }
      }
    },
    "A shared dumping ground for many tools. Mostly disposable, but read the child rows — some tools keep state here. Anything DevSweep already knows about is listed under its own heading instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gemeinsamer Ablageort für viele Tools. Überwiegend entbehrlich, aber lesen Sie die Unterzeilen — manche Tools speichern hier ihren Zustand. Alles, was DevSweep bereits kennt, ist stattdessen unter einer eigenen Überschrift aufgeführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vertedero compartido por muchas herramientas. En su mayoría prescindible, pero lee las filas hijas: algunas herramientas guardan aquí su estado. Lo que DevSweep ya conoce aparece bajo su propio encabezado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fourre-tout partagé par de nombreux outils. Généralement jetable, mais lisez les lignes enfants — certains outils y conservent leur état. Tout ce que DevSweep connaît déjà est listé sous sa propre rubrique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "多くのツールが共用する置き場所です。ほとんどは不要ですが、子の行を確認してください — 一部のツールはここに状態を保存します。DevSweepが把握しているものは、代わりに各自の見出しの下に表示されます。"
          }
        }
      }
    },
    "AI & ML models": {
      "comment": "Group heading: downloaded machine-learning models and caches.",
      "localizations": {
        "de": {
