          }
        }
      }
    },
    "Downloaded GHC and cabal archives. Re-downloadable.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladene GHC- und cabal-Archive. Erneut ladbar."
