            "value": "Eliminar simuladores no disponibles"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer les simulateurs indisponibles"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用できないシミュレータを削除"
          }
        }
      }
    },
    "Deno cache": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deno-Cache"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caché de Deno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache de Deno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Denoキャッシュ"
          }
        }
      }
    },
    "Deno's dependency and compilation cache. Re-fetched on the next run.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abhängigkeits- und Kompilierungs-Cache von Deno. Wird beim nächsten Lauf erneut geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caché de dependencias y compilación de Deno. Se vuelve a descargar en la próxima ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache des dépendances et de compilation de Deno. Récupéré à nouveau à la prochaine exécution."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Denoの依存関係とコンパイルのキャッシュです。次の実行時に再取得されます。"
          }
        }
      }
    },
    "Derived data": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derived Data"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos derivados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données dérivées"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Derived Data"
          }
        }
      }
    },
    "DevSweep already scans your whole home folder for build output. Pick a folder you would rather it left alone.": {
      "comment": "Folder picker message for excluding a folder.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweep durchsucht bereits Ihren gesamten Benutzerordner nach Build-Ausgaben. Wählen Sie einen Ordner, den es lieber in Ruhe lassen soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweep ya analiza toda tu carpeta de inicio en busca de resultados de compilación. Elige una carpeta que prefieras que no toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweep analyse déjà tout votre dossier de départ à la recherche de sorties de compilation. Choisissez un dossier que vous préférez lui faire ignorer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweepはすでにホームフォルダ全体でビルド出力をスキャンしています。スキャンから除外したいフォルダを選択してください。"
          }
        }
      }
    },
    "DevSweep is sandboxed for the App Store, so it only looks where you allow. In the picker, select the folder with the **house icon and your username** — that one grant covers every cache. Granting a smaller folder works too, but the results stay partial.": {
      "comment": "Welcome sheet, step 1 detail (App Store build). Markdown bold.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweep läuft für den App Store in einer Sandbox und sieht deshalb nur dorthin, wo Sie es erlauben. Wählen Sie im Dialog den Ordner mit dem **Haus-Symbol und Ihrem Benutzernamen** — diese eine Freigabe deckt jeden Cache ab. Ein kleinerer Ordner funktioniert auch, aber die Ergebnisse bleiben unvollständig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweep está aislado (sandbox) para el App Store, así que solo mira donde tú le permitas. En el selector, elige la carpeta con el **icono de la casa y tu nombre de usuario**: ese único permiso cubre todas las cachés. Conceder una carpeta más pequeña también funciona, pero los resultados quedan parciales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweep est isolé (sandbox) pour l’App Store : il ne regarde que là où vous l’autorisez. Dans le sélecteur, choisissez le dossier portant **l’icône de maison et votre nom d’utilisateur** — cette seule autorisation couvre tous les caches. Autoriser un dossier plus restreint fonctionne aussi, mais les résultats restent partiels."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweepはApp Store向けにサンドボックス化されているため、許可された場所しか見ません。ピッカーで**家のアイコンとあなたのユーザ名**が付いたフォルダを選択してください — その1回の許可ですべてのキャッシュを対象にできます。もっと小さいフォルダを許可することもできますが、結果は部分的なものになります。"
          }
        }
      }
    },
    "DevSweep never deletes. Everything it clears goes to the **Trash**, so you can always pull it back.\n\nEvery item is labelled — **Safe** to remove, **Review** first, or **Protected** and never touched. Your keys, credentials and settings are off-limits, and a separate guard double-checks every path before anything moves.": {
      "comment": "Welcome sheet, page 4 story. The bold Safe / Review / Protected must match the badge translations; 'Trash' is the macOS Trash. Markdown; keep the blank line.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweep löscht nie. Alles, was es aufräumt, wandert in den **Papierkorb**, sodass Sie es jederzeit zurückholen können.\n\nJedes Objekt ist markiert — **Sicher** zu entfernen, erst **Prüfen** oder **Geschützt** und nie angetastet. Ihre Schlüssel, Zugangsdaten und Einstellungen sind tabu, und eine separate Schutzprüfung kontrolliert jeden Pfad, bevor sich etwas bewegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweep nunca borra. Todo lo que limpia va a la **Papelera**, así que siempre puedes recuperarlo.\n\nCada ítem lleva su etiqueta: **Seguro** para eliminar, **Revisar** antes, o **Protegido** y nunca se toca. Tus claves, credenciales y ajustes quedan fuera de su alcance, y un guardián independiente comprueba dos veces cada ruta antes de mover nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweep ne supprime jamais rien. Tout ce qu’il nettoie va dans la **Corbeille**, vous pouvez donc toujours le récupérer.\n\nChaque élément est étiqueté — **Sûr** à retirer, **À vérifier** d’abord, ou **Protégé** et jamais touché. Vos clés, identifiants et réglages sont hors d’atteinte, et un garde-fou distinct revérifie chaque chemin avant tout déplacement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweepは削除しません。クリアしたものはすべて**ゴミ箱**に入るので、いつでも元に戻せます。\n\nすべての項目にラベルが付いています — 削除しても**安全**、先に**要確認**、または**保護**されていて一切触れません。鍵、認証情報、設定は対象外で、何かを移動する前に独立したガードがすべてのパスを再チェックします。"
          }
        }
      }
    },
    "DevSweep only looks where you let it. Choose your **Home folder** to cover every cache, or a single project or cache directory to keep it narrow. You can add or remove folders any time.": {
      "comment": "First-run text in the App Store build. Markdown bold.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweep sieht nur dorthin, wo Sie es zulassen. Wählen Sie Ihren **Benutzerordner**, um jeden Cache abzudecken, oder ein einzelnes Projekt- oder Cache-Verzeichnis, um den Bereich eng zu halten. Ordner können Sie jederzeit hinzufügen oder entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweep solo mira donde tú le dejes. Elige tu **carpeta de inicio** para cubrir todas las cachés, o un solo proyecto o directorio de caché para acotarlo. Puedes añadir o quitar carpetas cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweep ne regarde que là où vous l’y autorisez. Choisissez votre **dossier de départ** pour couvrir tous les caches, ou un seul projet ou dossier de cache pour rester ciblé. Vous pouvez ajouter ou retirer des dossiers à tout moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweepは許可された場所しか見ません。すべてのキャッシュを対象にするには**ホームフォルダ**を、範囲を絞るには単一のプロジェクトやキャッシュディレクトリを選択してください。フォルダはいつでも追加や削除ができます。"
          }
        }
      }
    },
    "DevSweep quits and reopens in the new language. Nothing is moved or deleted, and your last scan is kept.": {
      "comment": "Explains what happens when the language is changed.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweep wird beendet und in der neuen Sprache neu geöffnet. Nichts wird verschoben oder gelöscht, und Ihr letzter Scan bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweep se cierra y se vuelve a abrir en el nuevo idioma. No se mueve ni se borra nada, y tu último análisis se conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweep quitte et se rouvre dans la nouvelle langue. Rien n’est déplacé ni supprimé, et votre dernière analyse est conservée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweepを終了し、新しい言語で再び開きます。何も移動や削除はされず、最後のスキャン結果は保持されます。"
          }
        }
      }
    },
    "DevSweep restarts in the language you pick and brings you right back here. You can change it any time with the Language button at the top of the window.": {
      "comment": "Welcome sheet, first page text under the language choice.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweep startet in der gewählten Sprache neu und bringt Sie direkt hierher zurück. Sie können sie jederzeit über die Taste „Sprache“ oben im Fenster ändern."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ言語でDevSweepが再起動し、すぐにこの画面に戻ります。ウインドウ上部の「言語」ボタンでいつでも変更できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweep redémarre dans la langue choisie et vous ramène directement ici. Vous pourrez la changer à tout moment avec le bouton Langue en haut de la fenêtre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweep se reinicia en el idioma que elijas y te trae de vuelta aquí. Puedes cambiarlo en cualquier momento con el botón Idioma en la parte superior de la ventana."
          }
        }
      }
    },
    "DevSweep walks your home folder and measures what each tool left behind — it takes about a second.": {
      "comment": "Welcome sheet, step 1 detail (unsandboxed build).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweep durchläuft Ihren Benutzerordner und misst, was jedes Tool hinterlassen hat — das dauert etwa eine Sekunde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweep recorre tu carpeta de inicio y mide lo que cada herramienta ha dejado atrás: tarda alrededor de un segundo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweep parcourt votre dossier de départ et mesure ce que chaque outil a laissé derrière lui — cela prend environ une seconde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweepがホームフォルダを調べ、各ツールが残したものを計測します — 1秒ほどで終わります。"
          }
        }
      }
    },
    "Developer": {
      "comment": "Mode tab: the scan for developer toolchains and build output. Keep short.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwickler"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desarrollador"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Développeur"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発者"
          }
        }
      }
    },
    "Developer caches live under your **Home folder** (Xcode, npm, Gradle, and the rest). Add it to let DevSweep find them — you can still remove it later.": {
      "comment": "Empty state text when granted folders held no caches. Markdown bold; tool names stay.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwickler-Caches liegen in Ihrem **Benutzerordner** (Xcode, npm, Gradle und der Rest). Fügen Sie ihn hinzu, damit DevSweep sie findet — Sie können ihn später wieder entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cachés de desarrollo viven en tu **carpeta de inicio** (Xcode, npm, Gradle y el resto). Añádela para que DevSweep las encuentre; podrás quitarla más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les caches de développement se trouvent dans votre **dossier de départ** (Xcode, npm, Gradle et les autres). Ajoutez-le pour que DevSweep les trouve — vous pourrez toujours le retirer plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発者向けのキャッシュは**ホームフォルダ**の下にあります（Xcode、npm、Gradleなど）。DevSweepに検出させるにはホームフォルダを追加してください — 後から削除することもできます。"
          }
        }
      }
    },
    "Developer: toolchains, caches and build output. System Data: app caches, logs and device backups.": {
      "comment": "Tooltip on the mode tabs. 'Developer' and 'System Data' must match the tab names.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwickler: Toolchains, Caches und Build-Ausgaben. Systemdaten: App-Caches, Protokolle und Geräte-Backups."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desarrollador: cadenas de herramientas, cachés y resultados de compilación. Datos del sistema: cachés de apps, registros y copias de seguridad de dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Développeur : chaînes d’outils, caches et sorties de compilation. Données système : caches d’apps, journaux et sauvegardes d’appareils."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発者：ツールチェーン、キャッシュ、ビルド出力。システムデータ：アプリのキャッシュ、ログ、デバイスのバックアップ。"
          }
        }
      }
    },
    "Device backups": {
      "localizations": {
        "de": {
          "stringUnit": {
