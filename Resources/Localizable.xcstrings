    "Unity's import cache. Rebuilt automatically on the next project open — but reimporting a large project takes a long time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Import-Cache von Unity. Wird beim nächsten Öffnen des Projekts automatisch neu erstellt — aber der Reimport eines großen Projekts dauert lange."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caché de importación de Unity. Se regenera automáticamente al abrir de nuevo el proyecto, pero reimportar un proyecto grande lleva mucho tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache d’importation d’Unity. Reconstruit automatiquement à la prochaine ouverture du projet — mais réimporter un gros projet prend beaucoup de temps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Unityのインポートキャッシュです。次にプロジェクトを開くときに自動的に再構築されますが、大きなプロジェクトの再インポートには長い時間がかかります。"
          }
        }
      }
    },
    "Unity's shared package and shader cache. Re-downloaded and rebuilt on the next project open.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemeinsamer Paket- und Shader-Cache von Unity. Wird beim nächsten Öffnen des Projekts erneut geladen und neu erstellt."
