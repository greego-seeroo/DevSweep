    "Switch the language DevSweep runs in. The app relaunches; nothing is moved or deleted.": {
      "comment": "Tooltip on the Language button in the header.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechselt die Sprache, in der DevSweep läuft. Die App wird neu gestartet; nichts wird verschoben oder gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el idioma en el que se ejecuta DevSweep. La app se reabre; no se mueve ni se borra nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Change la langue dans laquelle DevSweep s’exécute. L’app se relance ; rien n’est déplacé ni supprimé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DevSweepの表示言語を切り替えます。アプリは再起動しますが、何も移動や削除はされません。"
          }
        }
      }
    },
    "System Data": {
      "comment": "Mode tab: the scan for app caches, logs and device backups. Use the exact term macOS System Settings ▸ General ▸ Storage shows for 'System Data' in this language.",
