        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos extraits de code, raccourcis clavier, thèmes, points d’arrêt et comportements. Rien de tout cela ne revient."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードスニペット、キーバインド、テーマ、ブレークポイント、動作設定です。これらは元に戻りません。"
          }
