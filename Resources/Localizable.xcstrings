    "JDKs Gradle downloaded via toolchain auto-provisioning. Re-downloaded on the next build that needs them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JDKs, die Gradle per automatischer Toolchain-Bereitstellung geladen hat. Werden beim nächsten Build, der sie braucht, erneut geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "JDK que Gradle descargó mediante el aprovisionamiento automático de cadenas de herramientas. Se vuelven a descargar en la próxima compilación que los necesite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "JDK téléchargés par Gradle via le provisionnement automatique des toolchains. Retéléchargés à la prochaine compilation qui en a besoin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradleがツールチェーンの自動プロビジョニングでダウンロードしたJDKです。必要になる次のビルドで再ダウンロードされます。"
          }
        }
      }
    },
