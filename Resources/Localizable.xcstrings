{
  "sourceLanguage": "en",
  "strings": {
    "%@  ·  %@": {
      "comment": "Row subtitle for a project artifact. %1$@ is the explanation of what the folder is, %2$@ is the project's path. Keep the separator.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  ·  %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@  ·  %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  ·  %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  ·  %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  ·  %@"
          }
        }
      }
    },
    "%@ already in the Trash": {
      "comment": "Disk gauge caption. %@ is the size of the Trash's contents.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bereits im Papierkorb"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya en la Papelera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ déjà dans la Corbeille"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はすでにゴミ箱にあります"
          }
        }
      }
    },
    "%@ failed (exit %d).": {
      "comment": "Result alert when a prune tool failed. %1$@ is the tool name, %2$d its exit code.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist fehlgeschlagen (Exit-Code %d)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ failed (exit %2$d)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha fallado (salida %d)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a échoué (code de sortie %d)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が失敗しました（終了コード %d）。"
          }
        }
      }
    },
    "%@ free of %@. %@": {
      "comment": "Accessibility value of the disk gauge. %1$@ free size, %2$@ total size, %3$@ the gauge caption.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ von %@ frei. %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ free of %2$@. %3$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ libres de %@. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ libres sur %@. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の空き（合計 %@）。%@"
          }
        }
      }
    },
    "%@ selected — freed once emptied": {
      "comment": "Disk gauge caption. %@ is the size of the selection; it is freed only when the Trash is emptied.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ausgewählt — frei nach dem Entleeren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seleccionados — se liberarán al vaciar la Papelera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sélectionnés — libérés une fois la Corbeille vidée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を選択中 — ゴミ箱を空にすると解放されます"
          }
        }
      }
    },
    "%@ timed out.": {
      "comment": "Result alert after a prune tool ran too long. %@ is the tool name.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat das Zeitlimit überschritten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha superado el tiempo de espera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a dépassé le délai imparti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がタイムアウトしました。"
          }
        }
      }
    },
    "%@ used": {
      "comment": "Disk gauge caption. %@ is the used size of the disk.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ belegt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en uso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ utilisés"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 使用中"
          }
        }
      }
    },
    "%@ used, %@ free.": {
      "comment": "Tooltip on the disk gauge. %1$@ used size, %2$@ free size.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ belegt, %@ frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ used, %2$@ free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en uso, %@ libres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ utilisés, %@ libres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 使用中、%@ 空き。"
          }
        }
      }
    },
    "%@ will be freed once you empty the Trash. Until then everything below is recoverable.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ werden frei, sobald Sie den Papierkorb entleeren. Bis dahin lässt sich alles unten Aufgeführte wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se liberarán cuando vacíes la Papelera. Hasta entonces, todo lo que hay debajo se puede recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seront libérés lorsque vous viderez la Corbeille. Jusque-là, tout ce qui figure ci-dessous est récupérable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱を空にすると %@ が解放されます。それまでは以下のすべてを元に戻せます。"
          }
        }
      }
    },
