    "IDE indexes and caches, one folder per Android Studio version. Rebuilt on next launch (first open will be slow).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "IDE-Indizes und -Caches, ein Ordner pro Android Studio-Version. Werden beim nächsten Start neu erstellt (das erste Öffnen ist langsam)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Índices y cachés del IDE, una carpeta por versión de Android Studio. Se regeneran al abrir de nuevo (la primera apertura será lenta)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Index et caches de l’IDE, un dossier par version d’Android Studio. Reconstruits au prochain lancement (la première ouverture sera lente)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IDEのインデックスとキャッシュで、Android Studioのバージョンごとに1フォルダです。次回起動時に再構築されます（最初に開くときは遅くなります）。"
          }
        }
      }
    },
    "IDE logs. Diagnostic only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "IDE-Protokolle. Nur zur Diagnose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros del IDE. Solo para diagnóstico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Journaux de l’IDE. À usage diagnostique uniquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IDEのログです。診断用のみです。"
          }
        }
      }
    },
    "Indexes and local history caches, one folder per IDE version. Rebuilt on next launch — the first project open will be slow.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Indizes und Caches des lokalen Verlaufs, ein Ordner pro IDE-Version. Werden beim nächsten Start neu erstellt — das erste Öffnen eines Projekts ist langsam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Índices y cachés del historial local, una carpeta por versión del IDE. Se regeneran al abrir de nuevo; la primera apertura de un proyecto será lenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Index et caches d’historique local, un dossier par version de l’IDE. Reconstruits au prochain lancement — la première ouverture de projet sera lente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インデックスとローカル履歴のキャッシュで、IDEのバージョンごとに1フォルダです。次回起動時に再構築されます — 最初にプロジェクトを開くときは遅くなります。"
          }
        }
      }
    },
    "Installed dependencies. Restored by `npm install`.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installierte Abhängigkeiten. Werden von `npm install` wiederhergestellt."
