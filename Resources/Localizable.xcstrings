    },
    "Signing profiles for device builds and distribution. Losing these breaks builds until you re-download them from the portal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaturprofile für Geräte-Builds und Distribution. Ohne sie schlagen Builds fehl, bis Sie sie erneut aus dem Portal laden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfiles de firma para compilaciones en dispositivo y distribución. Perderlos rompe las compilaciones hasta que los vuelvas a descargar del portal."
          }
