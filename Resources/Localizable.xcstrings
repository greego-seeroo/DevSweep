    },
    "Compiled JavaScript kept per VS Code version. Regenerated on launch; old versions' copies are dead weight.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompiliertes JavaScript, pro VS Code-Version aufbewahrt. Wird beim Start neu erzeugt; die Kopien alter Versionen sind toter Ballast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "JavaScript compilado que se guarda por cada versión de VS Code. Se regenera al abrir; las copias de versiones antiguas son peso muerto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "JavaScript compilé conservé pour chaque version de VS Code. Régénéré au lancement ; les copies des anciennes versions sont du poids mort."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VS Codeのバージョンごとに保持されるコンパイル済みJavaScriptです。起動時に再生成されるため、古いバージョンのコピーは無駄な容量です。"
          }
        }
      }
    },
    "Compiled Lua and shada scratch space. Rebuilt on next launch.": {
