        }
      }
    },
    "Downloaded ISOs and container images for minikube. Re-downloaded on the next `minikube start`.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladene ISOs und Container-Images für minikube. Werden beim nächsten `minikube start` erneut geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ISO e imágenes de contenedor descargadas para minikube. Se vuelven a descargar en el próximo `minikube start`."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ISO et images de conteneurs téléchargées pour minikube. Retéléchargées au prochain `minikube start`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "minikube用にダウンロードされたISOとコンテナイメージです。次の `minikube start` で再ダウンロードされます。"
          }
        }
      }
    },
    "Downloaded JDK and tool archives, already installed. Leftovers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladene JDK- und Tool-Archive, bereits installiert. Überbleibsel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos de JDK y herramientas descargados, ya instalados. Restos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Archives de JDK et d’outils téléchargées, déjà installées. Des restes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードされたJDKとツールのアーカイブで、すでにインストール済みです。残骸です。"
          }
        }
      }
    },
    "Downloaded Keras model weights and datasets.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladene Keras-Modellgewichte und -Datensätze."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesos de modelos y conjuntos de datos de Keras descargados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poids de modèles et jeux de données Keras téléchargés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードされたKerasのモデル重みとデータセットです。"
          }
        }
      }
    },
    "Downloaded Ruby source archives. Scratch space.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladene Ruby-Quellarchive. Arbeitsbereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos de código fuente de Ruby descargados. Espacio temporal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Archives sources de Ruby téléchargées. Espace temporaire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードされたRubyのソースアーカイブです。作業領域です。"
          }
        }
      }
    },
    "Downloaded and locally built Conan packages. Re-fetched on the next install, but anything built from source compiles again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladene und lokal gebaute Conan-Pakete. Werden bei der nächsten Installation erneut geladen, aber alles aus dem Quellcode Gebaute wird neu kompiliert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquetes de Conan descargados y compilados localmente. Se vuelven a descargar en la próxima instalación, pero lo compilado desde el código fuente se compila de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquets Conan téléchargés et compilés localement. Récupérés à nouveau à la prochaine installation, mais tout ce qui est compilé depuis les sources le sera de nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードおよびローカルでビルドされたConanパッケージです。次のインストール時に再取得されますが、ソースからビルドしたものは再びコンパイルされます。"
          }
        }
      }
    },
    "Downloaded and unpacked conda packages. Equivalent to `conda clean --packages`. Environments keep working; the packages re-download only if you build a new environment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladene und entpackte conda-Pakete. Entspricht `conda clean --packages`. Umgebungen funktionieren weiter; die Pakete werden nur erneut geladen, wenn Sie eine neue Umgebung anlegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquetes de conda descargados y desempaquetados. Equivale a `conda clean --packages`. Los entornos siguen funcionando; los paquetes solo se vuelven a descargar si creas un entorno nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquets conda téléchargés et décompressés. Équivaut à `conda clean --packages`. Les environnements continuent de fonctionner ; les paquets ne sont retéléchargés que si vous créez un nouvel environnement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードして展開されたcondaパッケージです。`conda clean --packages` と同等です。環境はそのまま動作し、新しい環境を作成するときにだけパッケージが再ダウンロードされます。"
          }
        }
      }
    },
    "Downloaded and unpacked crate sources plus the index. Cargo re-fetches what your builds need.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladene und entpackte Crate-Quellen samt Index. Cargo lädt erneut, was Ihre Builds brauchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código fuente de crates descargado y desempaquetado, más el índice. Cargo vuelve a descargar lo que necesiten tus compilaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sources de crates téléchargées et décompressées, plus l’index. Cargo récupère à nouveau ce dont vos compilations ont besoin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードして展開されたcrateのソースとインデックスです。Cargoはビルドに必要なものを再取得します。"
          }
        }
      }
    },
    "Downloaded base boxes, often gigabytes each. Re-downloaded by `vagrant up`.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladene Basis-Boxen, oft jeweils mehrere Gigabyte. Werden von `vagrant up` erneut geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Boxes base descargadas, a menudo de varios gigabytes cada una. `vagrant up` las vuelve a descargar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boxes de base téléchargées, souvent plusieurs gigaoctets chacune. Retéléchargées par `vagrant up`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードされたベースboxで、1つあたり数GBになることも多いです。`vagrant up` で再ダウンロードされます。"
          }
        }
      }
    },
    "Downloaded bottles and source tarballs. Equivalent to `brew cleanup` — see Tools for the full cleanup, which also removes old installed versions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladene Bottles und Quell-Tarballs. Entspricht `brew cleanup` — die vollständige Bereinigung, die auch alte installierte Versionen entfernt, finden Sie unter „Tools“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bottles y tarballs de código fuente descargados. Equivale a `brew cleanup`; consulta Herramientas para la limpieza completa, que también elimina versiones antiguas instaladas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bottles et archives sources téléchargées. Équivaut à `brew cleanup` — voir Outils pour le nettoyage complet, qui retire aussi les anciennes versions installées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードされたbottleとソースtarballです。`brew cleanup` と同等です — 古いインストール済みバージョンも削除する完全なクリーンアップは「ツール」を参照してください。"
          }
        }
      }
    },
    "Downloaded browser binaries for Playwright tests. Re-downloaded by `playwright install`.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladene Browser-Binärdateien für Playwright-Tests. Werden von `playwright install` erneut geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Binarios de navegadores descargados para las pruebas de Playwright. `playwright install` los vuelve a descargar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Binaires de navigateurs téléchargés pour les tests Playwright. Retéléchargés par `playwright install`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Playwrightテスト用にダウンロードされたブラウザバイナリです。`playwright install` で再ダウンロードされます。"
          }
        }
      }
    },
    "Downloaded dependencies and the build cache. Gradle re-fetches on the next build. Frequently tens of gigabytes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladene Abhängigkeiten und der Build-Cache. Gradle lädt sie beim nächsten Build erneut. Häufig Dutzende Gigabyte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dependencias descargadas y caché de compilación. Gradle lo vuelve a descargar en la próxima compilación. Con frecuencia, decenas de gigabytes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dépendances téléchargées et cache de compilation. Gradle les récupère à nouveau à la prochaine compilation. Souvent des dizaines de gigaoctets."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードされた依存関係とビルドキャッシュです。Gradleが次のビルドで再取得します。数十GBになることもよくあります。"
          }
        }
      }
    },
    "Downloaded developer documentation. Re-downloaded on demand.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladene Entwicklerdokumentation. Wird bei Bedarf erneut geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Documentación para desarrolladores descargada. Se vuelve a descargar cuando hace falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Documentation développeur téléchargée. Retéléchargée à la demande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードされた開発者向けドキュメントです。必要に応じて再ダウンロードされます。"
          }
        }
      }
    },
    "Downloaded distributions kept by Poetry. Re-fetched on demand.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Poetry aufbewahrte geladene Distributionen. Werden bei Bedarf erneut geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribuciones descargadas que guarda Poetry. Se vuelven a descargar cuando hacen falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Distributions téléchargées conservées par Poetry. Récupérées à nouveau à la demande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Poetryが保持するダウンロード済みディストリビューションです。必要に応じて再取得されます。"
          }
        }
      }
    },
    "Downloaded engine artifacts, the bundled Dart SDK and toolchain binaries for every platform you have built for. Restored by `flutter precache` / the next build, but it is a large download and `flutter` will not run until it finishes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladene Engine-Artefakte, das mitgelieferte Dart SDK und Toolchain-Binärdateien für jede Plattform, für die Sie gebaut haben. Wird von `flutter precache` / dem nächsten Build wiederhergestellt, aber das ist ein großer Download, und `flutter` läuft erst wieder, wenn er abgeschlossen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Artefactos del motor descargados, el SDK de Dart incluido y los binarios de la cadena de herramientas de cada plataforma para la que hayas compilado. Se restauran con `flutter precache` o en la próxima compilación, pero es una descarga grande y `flutter` no funcionará hasta que termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artefacts du moteur, SDK Dart embarqué et binaires de la chaîne d’outils téléchargés pour chaque plateforme que vous avez ciblée. Restaurés par `flutter precache` / la prochaine compilation, mais le téléchargement est volumineux et `flutter` ne fonctionnera pas avant la fin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードされたエンジンアーティファクト、同梱のDart SDK、ビルドしたことのある全プラットフォーム向けのツールチェーンバイナリです。`flutter precache` または次のビルドで復元されますが、大きなダウンロードになり、完了するまで `flutter` は動作しません。"
          }
        }
      }
    },
    "Downloaded extension packages, already installed. Pure leftovers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladene Erweiterungspakete, bereits installiert. Reine Überbleibsel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquetes de extensiones descargados, ya instalados. Puros restos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquets d’extensions téléchargés, déjà installés. De purs restes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードされた拡張機能パッケージで、すでにインストール済みです。純粋な残骸です。"
          }
        }
      }
    },
    "Downloaded model weights and compiled kernels. Re-downloaded on demand.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladene Modellgewichte und kompilierte Kernel. Werden bei Bedarf erneut geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesos de modelos descargados y kernels compilados. Se vuelven a descargar cuando hacen falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poids de modèles et noyaux compilés téléchargés. Retéléchargés à la demande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードされたモデルの重みとコンパイル済みカーネルです。必要に応じて再ダウンロードされます。"
          }
        }
      }
    },
    "Downloaded models and datasets, routinely tens of gigabytes. Everything re-downloads on demand, but these are very large fetches.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladene Modelle und Datensätze, regelmäßig Dutzende Gigabyte. Alles wird bei Bedarf erneut geladen, aber das sind sehr große Downloads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelos y conjuntos de datos descargados, habitualmente decenas de gigabytes. Todo se vuelve a descargar cuando hace falta, pero son descargas muy grandes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèles et jeux de données téléchargés, couramment des dizaines de gigaoctets. Tout se retélécharge à la demande, mais ce sont de très gros téléchargements."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードされたモデルとデータセットで、数十GBになるのが普通です。すべて必要に応じて再ダウンロードされますが、非常に大きな取得になります。"
          }
        }
      }
    },
    "Downloaded packages and metadata. `composer install` re-fetches them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladene Pakete und Metadaten. `composer install` lädt sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquetes y metadatos descargados. `composer install` los vuelve a descargar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquets et métadonnées téléchargés. `composer install` les récupère à nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードされたパッケージとメタデータです。`composer install` で再取得されます。"
          }
        }
      }
    },
    "Downloaded pod sources. `pod install` re-fetches them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladene Pod-Quellen. `pod install` lädt sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código fuente de pods descargado. `pod install` lo vuelve a descargar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sources de pods téléchargées. `pod install` les récupère à nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードされたpodのソースです。`pod install` で再取得されます。"
          }
        }
      }
    },
    "Downloaded providers and modules. Restored by `terraform init`.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladene Provider und Module. Werden von `terraform init` wiederhergestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proveedores y módulos descargados. `terraform init` los restaura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fournisseurs et modules téléchargés. Restaurés par `terraform init`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードされたプロバイダとモジュールです。`terraform init` で復元されます。"
          }
        }
      }
    },
    "Each emulator's disk and snapshots. Deleting loses installed apps and saved state; the device definition must be recreated in Device Manager.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Festplatte und Snapshots jedes Emulators. Beim Löschen gehen installierte Apps und gespeicherter Zustand verloren; die Gerätedefinition muss im Device Manager neu angelegt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco y las instantáneas de cada emulador. Borrarlos pierde las apps instaladas y el estado guardado; la definición del dispositivo habrá que recrearla en el Device Manager."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disque et instantanés de chaque émulateur. La suppression fait perdre les apps installées et l’état enregistré ; la définition de l’appareil devra être recréée dans le Device Manager."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各エミュレータのディスクとスナップショットです。削除するとインストール済みのアプリと保存された状態が失われ、デバイス定義をDevice Managerで再作成する必要があります。"
          }
        }
      }
    },
    "Editor and build logs. Diagnostic only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Editor- und Build-Protokolle. Nur zur Diagnose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros del editor y de compilación. Solo para diagnóstico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Journaux de l’éditeur et de compilation. À usage diagnostique uniquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エディタとビルドのログです。診断用のみです。"
          }
        }
      }
    },
    "Editor and extension host logs. Diagnostic only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Editor- und Extension-Host-Protokolle. Nur zur Diagnose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros del editor y del host de extensiones. Solo para diagnóstico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Journaux de l’éditeur et de l’hôte d’extensions. À usage diagnostique uniquement."
