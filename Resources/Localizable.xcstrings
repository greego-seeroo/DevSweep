        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caché compartida de paquetes y shaders de Unity. Se vuelve a descargar y regenerar al abrir de nuevo el proyecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache partagé de paquets et de shaders d’Unity. Retéléchargé et reconstruit à la prochaine ouverture du projet."
