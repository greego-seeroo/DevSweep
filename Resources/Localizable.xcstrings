    "Gradle itself, one copy per version your projects' wrappers pin. Re-downloaded on the next build.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradle selbst, eine Kopie pro Version, die die Wrapper Ihrer Projekte festlegen. Wird beim nächsten Build erneut geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El propio Gradle, una copia por cada versión que fijan los wrappers de tus proyectos. Se vuelve a descargar en la próxima compilación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradle lui-même, une copie par version épinglée par les wrappers de vos projets. Retéléchargé à la prochaine compilation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradle本体で、プロジェクトのwrapperが固定しているバージョンごとに1コピーです。次のビルドで再ダウンロードされます。"
          }
        }
      }
    },
