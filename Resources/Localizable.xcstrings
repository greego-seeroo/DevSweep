          }
        }
      }
    },
    "Diagnostic text files your apps wrote. Only useful when troubleshooting a problem; apps start new ones automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnose-Textdateien, die Ihre Apps geschrieben haben. Nur bei der Fehlersuche nützlich; Apps beginnen automatisch neue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos de texto de diagnóstico que escribieron tus apps. Solo sirven para resolver un problema; las apps crean otros nuevos automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers texte de diagnostic écrits par vos apps. Utiles seulement pour résoudre un problème ; les apps en créent de nouveaux automatiquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが書き出した診断用テキストファイルです。問題のトラブルシューティング時にだけ役立ち、アプリは自動的に新しいものを作成します。"
          }
        }
      }
    },
    "Disk space": {
      "comment": "Accessibility label of the disk gauge.",
      "localizations": {
